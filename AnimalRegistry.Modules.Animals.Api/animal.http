@HostAddress = https://localhost:5000

### Create Animal
POST {{HostAddress}}/animals
Authorization: Bearer {{$auth.token("auth0")}}
Content-Type: application/json

{
  "signature": "ABC123",
  "transponderCode": "XYZ789",
  "name": "Burek",
  "color": "Brown",
  "species": 1,
  "sex": 1,
  "birthDate": "2020-01-01T00:00:00Z"
}

### Get Animals
GET {{HostAddress}}/animals?page=1&pageSize=20
Authorization: Bearer {{$auth.token("auth0")}}
Content-Type: application/json

### Get Animal
GET {{HostAddress}}/animals/34c897df-8085-420b-942b-9e75e7e5fa99
Authorization: Bearer {{$auth.token("auth0")}}


### Shelter modules (enabled state for the current shelter)
GET {{HostAddress}}/shelter/features
Authorization: Bearer {{$auth.token("auth0")}}

### Enable animal origin module (requires Shelter_Admin role)
PUT {{HostAddress}}/shelter/features/animal-origin
Authorization: Bearer {{$auth.token("auth0")}}
Content-Type: application/json

{
  "isEnabled": true
}

### List municipalities (contractors)
GET {{HostAddress}}/municipalities?includeArchived=false
Authorization: Bearer {{$auth.token("auth0")}}

### Create municipality
POST {{HostAddress}}/municipalities
Authorization: Bearer {{$auth.token("auth0")}}
Content-Type: application/json

{
  "name": "Gmina Ząbki"
}

### Create animal with origin (origin module enabled)
POST {{HostAddress}}/animals
Authorization: Bearer {{$auth.token("auth0")}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="Signature"

2026/0001
--boundary
Content-Disposition: form-data; name="Name"

Burek
--boundary
Content-Disposition: form-data; name="Color"

Brown
--boundary
Content-Disposition: form-data; name="Breed"

Mix
--boundary
Content-Disposition: form-data; name="DistinguishingMarks"


--boundary
Content-Disposition: form-data; name="Species"

1
--boundary
Content-Disposition: form-data; name="Sex"

1
--boundary
Content-Disposition: form-data; name="Origin"

{"admissionDate":"2026-03-15T10:00:00+01:00","admissionMethod":1,"foundStreet":"Leśna 1","foundMunicipalityId":"00000000-0000-0000-0000-000000000000","contractorMunicipalityId":"00000000-0000-0000-0000-000000000000"}
--boundary--

### Monthly origin report
GET {{HostAddress}}/reports/origin/monthly?year=2026&month=3
Authorization: Bearer {{$auth.token("auth0")}}

### Yearly origin summary
GET {{HostAddress}}/reports/origin/yearly?year=2026
Authorization: Bearer {{$auth.token("auth0")}}

### Enable vaccinations module (requires Shelter_Admin)
PUT {{HostAddress}}/shelter/features/animal-vaccinations
Authorization: Bearer {{$auth.token("auth0")}}
Content-Type: application/json

{ "isEnabled": true }

### List animal vaccinations
GET {{HostAddress}}/animals/00000000-0000-0000-0000-000000000000/vaccinations
Authorization: Bearer {{$auth.token("auth0")}}

### Add vaccination (only vaccineName and administeredOn are required)
POST {{HostAddress}}/animals/00000000-0000-0000-0000-000000000000/vaccinations
Authorization: Bearer {{$auth.token("auth0")}}
Content-Type: application/json

{
  "vaccineName": "Nobivac Rabies",
  "administeredOn": "2026-10-10T00:00:00+02:00",
  "validUntil": "2027-10-10T00:00:00+02:00",
  "veterinarian": "Jan Kowalski",
  "batchNumber": "A123",
  "notes": "Pierwsza dawka"
}

### Renew vaccination (replacesVaccinationId marks an earlier vaccination of the animal as replaced)
POST {{HostAddress}}/animals/00000000-0000-0000-0000-000000000000/vaccinations
Authorization: Bearer {{$auth.token("auth0")}}
Content-Type: application/json

{
  "vaccineName": "Nobivac Rabies",
  "administeredOn": "2027-10-05T00:00:00+02:00",
  "validUntil": "2028-10-05T00:00:00+02:00",
  "replacesVaccinationId": "00000000-0000-0000-0000-000000000000"
}

### Update vaccination
PUT {{HostAddress}}/animals/00000000-0000-0000-0000-000000000000/vaccinations/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{$auth.token("auth0")}}
Content-Type: application/json

{
  "vaccineName": "Nobivac Rabies",
  "administeredOn": "2026-10-10T00:00:00+02:00",
  "validUntil": "2027-10-10T00:00:00+02:00"
}

### Delete vaccination
DELETE {{HostAddress}}/animals/00000000-0000-0000-0000-000000000000/vaccinations/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{$auth.token("auth0")}}

### Upload vaccination attachment
PUT {{HostAddress}}/animals/00000000-0000-0000-0000-000000000000/vaccinations/00000000-0000-0000-0000-000000000000/attachment
Authorization: Bearer {{$auth.token("auth0")}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="File"; filename="scan.pdf"
Content-Type: application/pdf

< ./scan.pdf
--boundary--

### Delete vaccination attachment
DELETE {{HostAddress}}/animals/00000000-0000-0000-0000-000000000000/vaccinations/00000000-0000-0000-0000-000000000000/attachment
Authorization: Bearer {{$auth.token("auth0")}}

### Vaccinations ending within 14 days, including expired ones
GET {{HostAddress}}/vaccinations?expiresInDays=14&includeExpired=true&inShelterOnly=true
Authorization: Bearer {{$auth.token("auth0")}}

### Expiring vaccinations report
GET {{HostAddress}}/reports/vaccinations/expiring?expiresInDays=30&includeExpired=true
Authorization: Bearer {{$auth.token("auth0")}}

### Vaccinations administered in a period
GET {{HostAddress}}/reports/vaccinations?from=2026-10-01T00:00:00%2B02:00&to=2026-10-31T00:00:00%2B01:00
Authorization: Bearer {{$auth.token("auth0")}}
